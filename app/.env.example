# Sólo del servidor: nunca uses el prefijo NEXT_PUBLIC_ para estas claves.

# Neon (la misma base que llena el backoffice).
DATABASE_URL=postgres://usuario:clave@host/neondb?sslmode=require

# Vercel AI Gateway: interpretación de consultas y embeddings.
AI_GATEWAY_API_KEY=tu_clave_de_vercel_ai_gateway

# Opcional: modelo para interpretar consultas (por defecto anthropic/claude-haiku-5.5).
# SEARCH_MODEL=anthropic/claude-haiku-5.5

# Mapa de /search (Maps JavaScript API). Excepción a la regla de arriba: esta clave va al
# navegador por diseño. Restringila en Google Cloud por referrer HTTP y sólo a Maps JavaScript API.
# No es la clave de Places del backoffice.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu_clave_de_navegador
# Map ID (requerido por los AdvancedMarker).
NEXT_PUBLIC_GOOGLE_MAP_ID=tu_map_id
