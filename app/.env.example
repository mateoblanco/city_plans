# Sólo del servidor: nunca uses el prefijo NEXT_PUBLIC_ para estas claves.

# Neon (la misma base que llena el backoffice).
DATABASE_URL=postgres://usuario:clave@host/neondb?sslmode=require

# Vercel AI Gateway: interpretación de consultas y embeddings.
AI_GATEWAY_API_KEY=tu_clave_de_vercel_ai_gateway

# Opcional: modelo para interpretar consultas (por defecto anthropic/claude-haiku-5.5).
# SEARCH_MODEL=anthropic/claude-haiku-5.5

# URL pública del bucket de logos en R2 (la misma que el backoffice). En la base sólo está la clave;
# la URL es LOGO_BASE_URL + "/" + logo_key. También habilita el origen en next/image.
LOGO_BASE_URL=https://pub-tu_id.r2.dev

# Google Places API (New), sólo del servidor: Place Details de la ficha /lugar/[slug].
# No es la clave del mapa de abajo; restringila en Google Cloud a Places API (New).
GOOGLE_PLACES_API_KEY=tu_clave_de_servidor

# Mapa de /search (Maps JavaScript API). Excepción a la regla de arriba: esta clave va al
# navegador por diseño. Restringila en Google Cloud por referrer HTTP y sólo a Maps JavaScript API.
# No es la clave de Places del backoffice.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu_clave_de_navegador
# Map ID (requerido por los AdvancedMarker).
NEXT_PUBLIC_GOOGLE_MAP_ID=tu_map_id

# Secreto de firma de URLs de Google Maps Platform (Google Cloud → Maps → Claves y credenciales → "URL signing
# secret"), sólo del servidor. Firma la imagen de Static Maps de la ficha en mobile (la URL se arma en el servidor y la
# pide el navegador con la clave de arriba, que también tiene que tener habilitada Maps Static API). Sin él, la ficha
# en mobile va sin mapa. Va en Production y Preview de Vercel.
GOOGLE_MAPS_SIGNING_SECRET=tu_secreto_de_firma

# Indexación (robots.txt, sitemap.xml, noindex). Por defecto false: nada se indexa hasta el lanzamiento. Sólo vale en
# Production de Vercel (VERCEL_ENV=production): en previews y en local nunca se indexa. Con true,
# robots permite (también a los rastreadores de LLMs), el sitemap lista home, guías y fichas, y /search sigue con
# noindex. La URL del sitio no es una variable: SITE_URL de src/lib/site.ts. Requiere un deploy nuevo.
# ALLOW_INDEXING=false

# Popularidad (eventos de ficha vista, guardar y "Google Maps"). Apagado por defecto: si no es exactamente "true", no se
# envía ni se guarda nada (ni se carga el código que envía). Prenderla SOLO en Production de Vercel; en desarrollo y en
# previews queda sin definir. Se lee en el build de las páginas: cambiarla requiere un deploy nuevo.
# TRACK_EVENTS=false

# Secreto del cron diario de popularidad (/api/cron/events-daily: resumen del día anterior y borrado de eventos de más
# de 90 días). Vercel lo manda en Authorization al correr el cron; sin él, el cron responde 401.
# CRON_SECRET=un_valor_aleatorio_largo

# Vista previa de las guías: con /guides/...?preview=<GUIDES_PREVIEW_SECRET>, una guía en borrador (o una publicada con
# cambios recién guardados) se ve en la app, sin cache y con noindex. Sin la clave (o con otra), un borrador da 404.
# Va sólo en el servidor (nunca NEXT_PUBLIC_), la misma que GUIDES_PREVIEW_SECRET del backoffice, que arma el link del
# botón "Vista previa". No la compartas: quien la tenga ve los borradores. Sin la variable no hay vista previa.
# GUIDES_PREVIEW_SECRET=una_clave_larga_y_aleatoria

# Analítica de producto (Mixpanel): token del proyecto. Sólo envía en Production de Vercel (VERCEL_ENV=production);
# en previews y en local no se manda nada aunque esté. Sin NEXT_PUBLIC_: el layout lo lee y se lo pasa al navegador
# (el token de proyecto de Mixpanel es público por diseño; no es el API secret). Va sólo en Production de Vercel.
# MIXPANEL_TOKEN=
# Local o preview: carga Mixpanel y escribe en la consola del navegador lo que mandaría ([mixpanel] evento {…}), sin
# enviar. En local, ponelo en `yarn build` y en `yarn start` (o en `yarn dev`).
# MIXPANEL_DEBUG=true
