    "cn": "^0.3.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "exa-js": "^2.23.0",
    "hono": "^4.13.8",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.47.0",
    "p-limit": "^7.3.3",
    "p-map": "^7.0.8",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
