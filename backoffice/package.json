{
  "name": "backoffice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prominence:recompute": "tsx server/scripts/prominence-recompute.ts",
    "signals:refresh": "tsx server/scripts/signals-refresh.ts",
    "logos:cleanup": "tsx server/scripts/logos-cleanup.ts",
    "extraction:replay": "tsx server/scripts/extraction-replay.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
