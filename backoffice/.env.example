# Google Places API (New). Clave privada: nunca uses el prefijo VITE_.
GOOGLE_PLACES_API_KEY=tu_clave_de_google

# Montevideo API de Transporte Público. Nunca uses el prefijo VITE_.
IM_CLIENT_ID=tu_client_id_de_montevideo_api
IM_CLIENT_SECRET=tu_client_secret_de_montevideo_api

# Vercel AI Gateway, usada únicamente por la extracción estructurada del servidor.
AI_GATEWAY_API_KEY=tu_clave_de_vercel_ai_gateway

# Exa Web Search. Nunca uses el prefijo VITE_ para esta clave.
EXA_API_KEY=tu_clave_de_exa

# Instagram público mediante Apify. El token se crea en Settings > API & Integrations.
APIFY_API_TOKEN=apify_api_tu_token
# Opcional; éste es el actor oficial usado por defecto.
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-profile-scraper

# Estimación de costo por extracción (USD). Google, Exa y GPT-5 mini usan
# precios de lista por defecto; definí estas variables para reflejar tu plan,
# el precio del actor de Apify o costos operativos propios.
# EXTRACTION_COST_GOOGLE_DETAILS_USD=0.025
# EXTRACTION_COST_EXA_SEARCH_USD=0.007
# EXTRACTION_COST_EXA_CONTENT_PAGE_USD=0.002
# EXTRACTION_COST_INSTAGRAM_RUN_USD=0
# EXTRACTION_COST_SCRAPING_REQUEST_USD=0
# EXTRACTION_COST_TRANSIT_REQUEST_USD=0
# EXTRACTION_COST_LLM_INPUT_TOKEN_USD=0.00000025
# EXTRACTION_COST_LLM_OUTPUT_TOKEN_USD=0.000002

# Overpass público: obligatorio identificar la aplicación y dar un contacto real.
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=CityPlansBackoffice/1.0 (contacto: tu-email@example.com)

# Puerto opcional del servidor local. Vite espera 8787 por defecto.
BACKOFFICE_API_PORT=8787
