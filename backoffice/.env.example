# Google Places API (New). Clave privada: nunca uses el prefijo VITE_.
GOOGLE_PLACES_API_KEY=tu_clave_de_google
# Opcional: tope de llamadas a Text Search por barrido de barrio (1500 por defecto).
# NEIGHBORHOOD_SWEEP_MAX_CALLS=1500

# Montevideo API de Transporte Público. Nunca uses el prefijo VITE_.
IM_CLIENT_ID=tu_client_id_de_montevideo_api
IM_CLIENT_SECRET=tu_client_secret_de_montevideo_api

# Vercel AI Gateway, usada únicamente por la extracción estructurada del servidor.
AI_GATEWAY_API_KEY=tu_clave_de_vercel_ai_gateway

# Concurrencia máxima por servicio en el servidor, compartida por todas las extracciones.
# EXTRACT_LIMIT_APIFY=2
# EXTRACT_LIMIT_EXA=3
# EXTRACT_LIMIT_LLM=3

# Exa Web Search. Nunca uses el prefijo VITE_ para esta clave.
EXA_API_KEY=tu_clave_de_exa

# Instagram público mediante Apify. El token se crea en Settings > API & Integrations.
APIFY_API_TOKEN=apify_api_tu_token
# Opcional; éste es el actor oficial usado por defecto.
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-profile-scraper
# Opcional; memoria de cada corrida en MB (potencia de 2, desde 128). Sin valor, la del actor (1024).
# APIFY_MEMORY_MB=1024

# Logos en Cloudflare R2 (bucket "logos", público). Prefijo R2_ para no mezclarlas con
# credenciales de AWS. Token de R2 con permiso Object Read & Write sobre el bucket.
R2_ACCESS_KEY_ID=tu_access_key_id_de_r2
R2_SECRET_ACCESS_KEY=tu_secret_access_key_de_r2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
# URL pública del bucket (r2.dev o dominio propio). En la base sólo se guarda la clave del logo;
# la URL es LOGO_BASE_URL + "/" + logo_key. La app de Next usa la misma variable.
LOGO_BASE_URL=https://pub-tu_id.r2.dev
# Opcional: modelo con visión que clasifica la foto de perfil. Por defecto el Haiku de la búsqueda.
# LOGO_MODEL=anthropic/claude-haiku-5.5

# Modelo de extracción (id del AI Gateway) y esfuerzo de razonamiento: low, medium o high.
# Por defecto: anthropic/claude-sonnet-5.5 con medium. Para pruebas más baratas:
# EXTRACTION_MODEL=openai/gpt-5-mini
# EXTRACTION_REASONING=low

# Modelo de la segunda búsqueda de horarios (cadenas), siempre con razonamiento low.
# Por defecto: openai/gpt-5-mini.
# HOURS_MODEL=openai/gpt-5-mini

# Costo por extracción (USD). El LLM se calcula con los tokens reales y el precio
# del modelo; Google y Exa usan precios de lista. Definí estas variables para
# reflejar tu plan, el precio del actor de Apify o costos operativos propios.
# EXTRACTION_COST_GOOGLE_DETAILS_USD=0.025
# EXTRACTION_COST_EXA_SEARCH_USD=0.007
# EXTRACTION_COST_EXA_CONTENT_PAGE_USD=0
# EXTRACTION_COST_EXA_HIGHLIGHT_PAGE_USD=0
# EXTRACTION_COST_INSTAGRAM_RUN_USD=0
# EXTRACTION_COST_SCRAPING_REQUEST_USD=0
# EXTRACTION_COST_TRANSIT_REQUEST_USD=0
# EXTRACTION_COST_LLM_INPUT_TOKEN_USD=0.00000025
# EXTRACTION_COST_LLM_OUTPUT_TOKEN_USD=0.000002

# Overpass público: obligatorio identificar la aplicación y dar un contacto real.
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=CityPlansBackoffice/1.0 (contacto: tu-email@example.com)

# Puerto opcional del servidor local. Vite espera 8787 por defecto.
BACKOFFICE_API_PORT=8787
